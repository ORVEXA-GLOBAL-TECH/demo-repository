# ==============================================================================
# ALLEVIARE PHARMA SFA ENTERPRISE API - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=alleviare_super_secure_enterprise_jwt_secret_key_2026

# Allowed CORS Origins (Comma-separated for multiple origins, or * for open)
CORS_ORIGIN=*

# ==============================================================================
# PRIMARY DATABASE: PostgreSQL 16
# ==============================================================================
# OPTION 1: Full Connection String URI (Best for Neon.tech, Supabase, Azure, AWS RDS)
DATABASE_URL=postgresql://postgres:postgrespassword2026@localhost:5432/alleviare_sfa

# OPTION 2: Individual Connection Parameters (Alternative)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgrespassword2026
# PGDATABASE=alleviare_sfa
# PGSSL=false

# Max Pool Connections (Default 20)
PG_MAX_POOL=20
DEBUG_SQL=false

# ==============================================================================
# FAST CACHE & RATE LIMITER: Azure Cache for Redis / Local Redis
# ==============================================================================
# Option 1: Rediss Connection String for Azure Cache for Redis (TLS SSL Port 6380)
# REDIS_URL=rediss://:<your_access_key>@<your_cache_name>.redis.cache.windows.net:6380

# Option 2: Individual Connection Parameters for Azure Cache for Redis
REDIS_HOST=your-cache-name.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your_azure_redis_primary_access_key
REDIS_TLS=true

# Option 3: Local Redis Development
# REDIS_URL=redis://localhost:6379


# ==============================================================================
# CLOUD OBJECT STORAGE: Azure Blob Storage / AWS S3 / Cloudflare R2
# ==============================================================================
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
# S3_BUCKET_NAME=alleviare-enterprise-docs
