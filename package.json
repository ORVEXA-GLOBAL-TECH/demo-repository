{
  "name": "alleviare-sfa-suite",
  "version": "1.0.0",
  "description": "Alleviare Pharma Field Sales Force Automation (SFA) & Orvexa SaaS Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "npm run dev:backend",
    "dev:backend": "npm --prefix backend start",
    "dev:web": "npm --prefix frontend/web run dev",
    "dev:staff": "npm --prefix frontend/web run dev",
    "dev:superadmin": "npm --prefix frontend/superadmin run dev",
    "dev:mobile": "npm --prefix frontend/mobile start",
    "build:web": "npm --prefix frontend/web run build",
    "build:staff": "npm --prefix frontend/web run build",
    "build:superadmin": "npm --prefix frontend/superadmin run build",
    "build:all": "npm run build:web && npm run build:superadmin"
  },
  "keywords": [
    "pharma-sfa",
    "dcr",
    "react",
    "vite",
    "nodejs",
    "express",
    "react-native",
    "superadmin",
    "saas"
  ],
  "author": "Alleviare Team",
  "license": "ISC"
}
