# Copy to .env (never commit .env). Used by docker-compose.yml.
POSTGRES_USER=alleviare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alleviare

# openssl rand -base64 48
JWT_SECRET=

# Browser origin of the web app and the public URL of the API (as the browser reaches it)
WEB_ORIGIN=http://localhost:3001
PUBLIC_API_URL=http://localhost:8080

# First-run provisioning: creates the company and its first administrator, then set back to false
BOOTSTRAP_ENABLED=false
BOOTSTRAP_COMPANY_CODE=
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_CURRENCY=USD
BOOTSTRAP_TIMEZONE=UTC
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
